---
interface Props {
  caption: string;
  horizontal?: boolean;
  notRounded?: boolean;
  notShadowed?: boolean;
}

const {
  caption,
  horizontal = false,
  notRounded = false,
  notShadowed = false,
} = Astro.props;
---

<style>
  .figure-container {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 0.25rem;
  }

  .figure-caption {
    text-align: center;
    font-weight: 500;
    margin-top: 0;
  }

  .images-container {
    display: flex;
    align-items: center;
    justify-content: center;
    align-content: center;
    gap: 0.5rem;
  }

  .images-container.horizontal {
    flex-direction: row;
    width: 100%;
  }

  .images-container.vertical {
    flex-direction: column;
  }

  .image-shadowed {
    filter: drop-shadow(0rem 0rem 0.25rem);
  }
</style>

<figure class="figure-container">
  <div
    class={`images-container ${horizontal ? "horizontal" : "vertical"} ${
      notRounded ? "" : "image-rounded"
    } ${notShadowed ? "" : "image-shadowed"}`}
  >
    <slot />
  </div>
  <figcaption class="figure-caption">{caption}</figcaption>
</figure>
